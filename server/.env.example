# Server Environment Variables (Production & Development)
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# Database Connection (MongoDB Atlas or Local instance)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/snakeDB?retryWrites=true&w=majority

# JSON Web Token Secret for auth and session signing
JWT_SECRET=your_production_jwt_secret_key_minimum_32_characters

# Google OAuth 2.0 Client ID (Web Application credentials)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Frontend URL for production CORS validation (e.g., https://your-snake-game.vercel.app)
FRONTEND_URL=https://your-snake-game.vercel.app
