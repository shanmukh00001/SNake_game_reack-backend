# ==============================================================================
# Snake Arcade — Root Environment Configuration Reference
# Copy the variables below to their respective .env files in /server and /client
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Environment Variables (server/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/snakeDB
JWT_SECRET=your_super_secret_jwt_encryption_key_min_32_characters
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend Environment Variables (client/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
